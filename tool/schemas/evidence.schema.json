{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equiv.local/schemas/evidence.schema.json",
  "title": "Aiken feature evidence verdicts",
  "type": "object",
  "required": ["schema_version", "package", "compiler_pair", "lane_runs", "record_count", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "package": {"type": "string", "minLength": 1},
    "compiler_pair": {
      "type": "object",
      "required": ["old", "new"],
      "properties": {
        "old": {"type": "string", "minLength": 1},
        "new": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "lane_runs": {
      "type": "object",
      "required": ["old", "new"],
      "properties": {
        "old": {"type": "object"},
        "new": {"type": "object"}
      },
      "additionalProperties": false
    },
    "record_count": {"const": 393},
    "records": {
      "type": "array",
      "minItems": 393,
      "maxItems": 393,
      "items": {
        "type": "object",
        "required": [
          "feature_id",
          "row_kind",
          "package",
          "lanes",
          "impact",
          "required_evidence",
          "result",
          "blaster_pending",
          "verification_status"
        ],
        "properties": {
          "feature_id": {"type": "string", "minLength": 1},
          "row_kind": {"enum": ["feature", "builtin"]},
          "package": {"type": "string", "minLength": 1},
          "lanes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "impact": {"type": "string", "minLength": 1},
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["rule", "state", "references"],
              "properties": {
                "rule": {"type": "string", "minLength": 1},
                "state": {"enum": ["satisfied", "missing", "not_applicable"]},
                "references": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          },
          "result": {
            "type": ["string", "null"],
            "enum": [
              "equivalent",
              "non_equivalent",
              "blaster_unsupported",
              "blaster_inconclusive",
              "old_language_feature_unsupported",
              "old_compile_failed",
              "new_compile_failed",
              "feature_missing",
              "dead_code_only",
              "expected_negative_diagnostic",
              null
            ]
          },
          "blaster_pending": {"type": "boolean"},
          "verification_status": {"enum": ["manifested_verified", "manifested_unverified"]}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
