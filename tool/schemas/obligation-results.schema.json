{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equiv.local/schemas/obligation-results.schema.json",
  "type": "object",
  "required": ["schema_version", "record_count", "records"],
  "properties": {
    "schema_version": {"const": 2},
    "record_count": {"type": "integer", "minimum": 0},
    "records": {"type": "array", "items": {
      "type": "object",
      "required": ["evidence_result_id", "logical_obligation_id", "checker_configuration_id", "attempt_id", "status", "generated_lean_sha256", "witness_sha256", "program_pair_id", "semantic_model_id", "obligation_kind", "generated_source_schema_version", "generated_lean_path", "solver_status", "reused"],
      "properties": {
        "evidence_result_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "logical_obligation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checker_configuration_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "status": {"type": "string"},
        "generated_lean_sha256": {"type": ["string", "null"]},
        "witness_sha256": {"type": ["string", "null"]},
        "program_pair_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_model_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "obligation_kind": {"type": "string"},
        "generated_source_schema_version": {"const": "equiv-generated-lean/v2"},
        "generated_lean_path": {"type": ["string", "null"]},
        "solver_status": {"type": ["string", "null"]},
        "reused": {"type": "boolean"}
      },
      "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
