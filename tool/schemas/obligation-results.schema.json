{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equiv.local/schemas/obligation-results.schema.json",
  "type": "object",
  "required": ["schema_version", "record_count", "records"],
  "properties": {
    "schema_version": {"const": 2},
    "record_count": {"type": "integer", "minimum": 0},
    "records": {"type": "array", "items": {
      "type": "object",
      "required": [
        "evidence_result_id",
        "logical_obligation_id",
        "obligation_attempt_id",
        "execution_attempt_id",
        "checker_configuration_id",
        "checker_implementation_id",
        "program_pair_id",
        "semantic_model_id",
        "obligation_kind",
        "status",
        "generated_source_sha256",
        "generated_source_schema_version",
        "generated_source_path",
        "solver_status",
        "witness_reference",
        "replay_reference",
        "relevant_solver_options",
        "attempt_sequence",
        "reused"
      ],
      "properties": {
        "evidence_result_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "logical_obligation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "obligation_attempt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "execution_attempt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checker_configuration_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "checker_implementation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "program_pair_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_model_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "obligation_kind": {"type": "string"},
        "status": {"enum": ["proven", "valid", "falsified", "bounded", "unsupported", "not_applicable", "timeout", "tool_error", "invalid", "inconclusive"]},
        "generated_source_sha256": {"type": ["string", "null"]},
        "generated_source_schema_version": {"const": "equiv-generated-lean/v3"},
        "generated_source_path": {"type": ["string", "null"]},
        "solver_status": {"type": ["string", "null"]},
        "witness_reference": {"type": ["string", "null"]},
        "replay_reference": {"type": ["string", "null"]},
        "relevant_solver_options": {"type": "object"},
        "attempt_sequence": {"type": "integer", "minimum": 1},
        "reused": {"type": "boolean"}
      },
      "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
