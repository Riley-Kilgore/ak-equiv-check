{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equiv.local/schemas/census.schema.json",
  "title": "Aiken feature source census",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "feature_id",
      "file",
      "line_start",
      "line_end",
      "ast_node_kind",
      "detector_rule",
      "marker_bound"
    ],
    "properties": {
      "feature_id": {"type": "string", "minLength": 1},
      "file": {"type": "string", "minLength": 1},
      "line_start": {"type": "integer", "minimum": 1},
      "line_end": {"type": "integer", "minimum": 1},
      "byte_start": {"type": "integer", "minimum": 0},
      "byte_end": {"type": "integer", "minimum": 0},
      "ast_node_kind": {"type": "string", "minLength": 1},
      "ast_path": {"type": "array", "items": {"type": "string"}},
      "detector_rule": {"type": "string", "minLength": 1},
      "marker_bound": {"type": "boolean"},
      "branch_selector": {"type": "integer"},
      "syntax_example": {"type": "string"}
    },
    "additionalProperties": false
  }
}
