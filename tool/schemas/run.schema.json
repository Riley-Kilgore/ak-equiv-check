{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equiv.local/schemas/run.schema.json",
  "type": "object",
  "required": [
    "schema_version", "run_id", "mode", "package", "package_path", "source",
    "source_hash", "dependency_lock_hash", "compiler_pair", "checker_configuration",
    "blaster_configuration", "reproducibility_gaps", "source_immutable",
    "strict_requested", "strict_pass"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "mode": {"enum": ["package", "sentinel"]},
    "package": {"type": "string", "minLength": 1},
    "package_path": {"type": "string", "minLength": 1},
    "source": {"type": "object"},
    "source_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "dependency_lock_hash": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "compiler_pair": {
      "type": "object",
      "required": ["old", "new"],
      "properties": {"old": {"type": "object"}, "new": {"type": "object"}},
      "additionalProperties": false
    },
    "checker_configuration": {"type": "object"},
    "blaster_configuration": {"type": "object"},
    "reproducibility_gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "source_immutable": {"type": "boolean"},
    "strict_requested": {"type": "boolean"},
    "strict_pass": {"type": "boolean"}
  },
  "additionalProperties": false
}
