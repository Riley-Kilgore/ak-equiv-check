{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equiv.local/schemas/program-pairs.schema.json",
  "type": "object",
  "required": ["schema_version", "record_count", "records"],
  "properties": {
    "schema_version": {"const": 2},
    "record_count": {"type": "integer", "minimum": 0},
    "records": {"type": "array", "items": {
      "type": "object",
      "required": ["program_pair_id", "old_program_artifact", "new_program_artifact", "verified_abi_id", "verified_abi", "plutus_version", "handler_pair_ids", "handler_references", "covered_feature_ids"],
      "properties": {
        "program_pair_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "old_program_artifact": {"type": "object"},
        "new_program_artifact": {"type": "object"},
        "verified_abi_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "verified_abi": {"type": "object"},
        "plutus_version": {"type": "string"},
        "handler_pair_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "handler_references": {"type": "array", "items": {"type": "object"}},
        "covered_feature_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
