{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equiv.local/schemas/semantic-obligations.schema.json",
  "type": "object",
  "required": ["schema_version", "record_count", "records"],
  "properties": {
    "schema_version": {"const": 2},
    "record_count": {"type": "integer", "minimum": 0},
    "records": {"type": "array", "items": {
      "type": "object",
      "required": ["logical_obligation_id", "program_pair_id", "semantic_model_id", "obligation_kind", "semantic_runtime_bound", "input_model"],
      "properties": {
        "logical_obligation_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "program_pair_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "semantic_model_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "obligation_kind": {"enum": ["domain_non_vacuity", "old_program_completion", "new_program_completion", "observational_equivalence", "ledger_domain_non_vacuity", "ledger_observational_equivalence"]},
        "semantic_runtime_bound": {"type": "integer", "minimum": 1},
        "input_model": {"type": "object"}
      },
      "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
