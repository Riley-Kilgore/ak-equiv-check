{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equiv.local/schemas/pair-results.schema.json",
  "type": "object",
  "required": ["schema_version", "record_count", "records"],
  "properties": {
    "schema_version": {"const": 2},
    "record_count": {"type": "integer", "minimum": 0},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "program_pair_id", "evidence_id", "cache_binding", "attempt_id",
          "attempt_sequence", "execution_environment", "source_identity",
          "handler_pair_ids", "handler_references", "compiler_pair",
          "old_program_artifact", "new_program_artifact", "verified_abi_id",
          "verified_abi", "covered_feature_ids", "semantic_model_id",
          "input_model", "domain_assumptions", "semantic_contract",
          "excluded_observations", "checker_configuration", "runtime_step_bound",
          "fuel_semantics", "timeouts", "evaluator", "secondary_evaluator",
          "status", "command", "exit_code", "duration_seconds",
          "generated_lean_path", "generated_lean_sha256", "stdout_path",
          "stderr_path", "solver_input_path", "solver_input_sha256", "witness",
          "phase_results", "proof_obligations", "counterexample_replay",
          "evidence_reuse", "error", "cost_and_trace", "run_id", "model_results",
          "artifact_checksum"
        ],
        "properties": {
          "program_pair_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "evidence_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "cache_binding": {"type": "object"},
          "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "attempt_sequence": {"type": "integer", "minimum": 1},
          "execution_environment": {"type": "string", "minLength": 1},
          "source_identity": {"type": "object"},
          "handler_pair_ids": {"type": "array", "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "uniqueItems": true},
          "handler_references": {"type": "array", "items": {"type": "object"}},
          "compiler_pair": {"type": "object"},
          "old_program_artifact": {"$ref": "#/$defs/programArtifact"},
          "new_program_artifact": {"$ref": "#/$defs/programArtifact"},
          "verified_abi_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "verified_abi": {"type": "object"},
          "covered_feature_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "semantic_model_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "input_model": {"type": "object"},
          "domain_assumptions": {"type": "array", "items": {"type": "string"}},
          "semantic_contract": {"type": "string"},
          "excluded_observations": {"type": "array", "items": {"type": "string"}},
          "checker_configuration": {"type": "object"},
          "runtime_step_bound": {"type": "integer", "minimum": 1},
          "fuel_semantics": {"type": "string"},
          "timeouts": {"type": "object"},
          "evaluator": {"type": ["object", "null"]},
          "secondary_evaluator": {"type": ["object", "null"]},
          "status": {"type": "string"},
          "command": {"type": ["array", "null"], "items": {"type": "string"}},
          "exit_code": {"type": ["integer", "null"]},
          "duration_seconds": {"type": "number", "minimum": 0},
          "generated_lean_path": {"type": ["string", "null"]},
          "generated_lean_sha256": {"type": ["string", "null"]},
          "stdout_path": {"type": ["string", "null"]},
          "stderr_path": {"type": ["string", "null"]},
          "solver_input_path": {"type": ["string", "null"]},
          "solver_input_sha256": {"type": ["string", "null"]},
          "witness": {"type": ["object", "null"]},
          "phase_results": {"type": "array", "items": {"type": "object"}},
          "proof_obligations": {"type": "object"},
          "counterexample_replay": {"type": ["object", "null"]},
          "evidence_reuse": {"type": ["object", "null"]},
          "error": {"type": ["string", "null"]},
          "cost_and_trace": {"type": "object"},
          "run_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "model_results": {"type": "object"},
          "artifact_checksum": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "programArtifact": {
      "type": "object",
      "required": ["program_artifact_id", "path", "script_sha256", "script_size", "serialization_format", "plutus_version", "source_validator_references", "compiler_artifact_id"],
      "properties": {
        "program_artifact_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "path": {"type": "string"},
        "script_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "script_size": {"type": "integer", "minimum": 0},
        "serialization_format": {"type": "string"},
        "plutus_version": {"type": "string"},
        "source_validator_references": {"type": "array", "items": {"type": "string"}},
        "compiler_artifact_id": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
