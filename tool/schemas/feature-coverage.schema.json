{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equiv.local/schemas/feature-coverage.schema.json",
  "type": "object",
  "required": ["schema_version", "mode", "record_count", "records"],
  "properties": {
    "schema_version": {"const": 2},
    "mode": {"enum": ["package", "sentinel"]},
    "record_count": {"type": "integer", "minimum": 0},
    "records": {"type": "array", "items": {
      "type": "object",
      "required": ["feature_id", "row_kind", "lanes", "manifest_present", "source_present", "old_build_accepted", "new_build_accepted", "lane_results_old", "lane_results_new", "reachability_required", "old_reachability", "new_reachability", "handler_pair_ids", "program_pair_ids", "semantic_obligation_ids", "all_linked_evidence", "required_evidence", "authoritative_evidence", "pair_results", "aggregate_feature_result", "status"],
      "properties": {
        "feature_id": {"type": "string"}, "row_kind": {"type": "string"},
        "lanes": {"type": "array", "items": {"type": "string"}},
        "manifest_present": {"type": "boolean"}, "source_present": {"type": "boolean"},
        "old_build_accepted": {"type": "boolean"}, "new_build_accepted": {"type": "boolean"},
        "lane_results_old": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "lane_results_new": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "reachability_required": {"type": "boolean"},
        "old_reachability": {"type": ["object", "null"]}, "new_reachability": {"type": ["object", "null"]},
        "handler_pair_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "program_pair_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "semantic_obligation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "all_linked_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "required_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "authoritative_evidence": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "pair_results": {"type": "array", "items": {"type": "object"}},
        "aggregate_feature_result": {"type": "string"}, "status": {"type": "string"}
      },
      "additionalProperties": false
    }}
  },
  "additionalProperties": false
}
