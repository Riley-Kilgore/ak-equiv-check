{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://equiv.local/schemas/summary-v2.schema.json",
  "type": "object",
  "required": [
    "schema_version", "run_id", "package", "mode", "strict_requested", "strict_pass",
    "best_effort_completed", "counts", "status_counts", "gaps", "output",
    "source_immutable", "dependency_lock_shared", "schema_errors"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "package": {"type": "string", "minLength": 1},
    "mode": {"enum": ["package", "sentinel"]},
    "strict_requested": {"type": "boolean"},
    "strict_pass": {"type": "boolean"},
    "best_effort_completed": {"const": true},
    "counts": {
      "type": "object",
      "required": [
        "validators_discovered", "validators_discovered_old", "validators_discovered_new",
        "validators_paired", "identical_pairs", "blaster_valid_pairs", "confirmed_differences",
        "unreplayed_falsifications", "inconclusive_pairs", "unsupported_pairs", "build_failures",
        "compatibility_differences", "shared_features_covered", "shared_features_missing"
      ],
      "additionalProperties": {"type": "integer", "minimum": 0}
    },
    "status_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "gaps": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "output": {"type": "string", "minLength": 1},
    "source_immutable": {"type": "boolean"},
    "dependency_lock_shared": {"type": "boolean"},
    "schema_errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
